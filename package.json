{
  "name": "illyaverse",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/serendipity", "tools/kaleidoscope/ui"],
  "scripts": {
    "dev": "npm run dev --workspace @illyaverse/serendipity",
    "build": "npm run build --workspace @illyaverse/serendipity",
    "lint": "npm run lint --workspace @illyaverse/serendipity",
    "typecheck": "npm run typecheck --workspace @illyaverse/serendipity",
    "test:rust": "cargo test --workspace",
    "test:migrations": "node --test infra/tests/migration-source.test.mjs",
    "test:availability:db": "node infra/beatmapset-availability-smoke.mjs",
    "test:web:disposable": "node infra/disposable-web-smoke.mjs"
  },
  "engines": {"node": ">=22.0.0"}
}
