<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>osu.Game.Rulesets.Transfiguration</AssemblyName>
    <RootNamespace>Illyaverse.Transfiguration</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NativeRoot Condition="'$(NativeRoot)' == ''">$(LOCALAPPDATA)/osulazer/current</NativeRoot>
    <DefineConstants Condition="'$(Fixture)' == 'true'">$(DefineConstants);ILLYAVERSE_FIXTURE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" GeneratePathProperty="true" />
    <EmbeddedResource Include="$(PkgLib_Harmony)/lib/net10.0/0Harmony.dll" LogicalName="Illyaverse.Transfiguration.0Harmony.dll" />
    <Reference Include="osu.Game"><HintPath>$(NativeRoot)/osu.Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="osu.Framework"><HintPath>$(NativeRoot)/osu.Framework.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
