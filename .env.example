# Run infra/setup.ps1 or infra/setup.sh to create .env with independent random secrets.
# Empty secrets intentionally prevent docker compose up before setup.
POSTGRES_PASSWORD=
SESSION_SECRET=
INTERNAL_SERVICE_KEY=

# Local browser access must use this exact origin (scheme, host, port).
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Optional account recovery email. SMTP_HOST + SMTP_FROM + encryption key enable it.
# Setup creates an independent key even when SMTP is off. Retain it with backups.
MAIL_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (default, required upgrade) or implicit (TLS from connection start).
# none only permits a loopback SMTP host with explicit local development opt-in.
SMTP_TLS=starttls
# Also permits HTTP PUBLIC_ORIGIN on localhost/loopback or a .test domain.
MAIL_ALLOW_LOCAL_DEV=false
ILLYA_DOMAIN=illya.example.com
# Optional: defaults to PUBLIC_ORIGIN converted to ws/wss plus /notification-server.
LAZER_NOTIFICATION_ENDPOINT=
ACME_EMAIL=operator@example.com

# Initial administrator. Setup generates an independent random password.
# After first successful startup, clear all three values and recreate Sanctuary.
BOOTSTRAP_ADMIN_USERNAME=illya_admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@illya.test

# Official map import is optional. Obtain your own osu! OAuth client credentials.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
OSU_API_INTERVAL_MS=1000
# Optional complete archive acquisition. Empty keeps metadata-only sets unavailable.
# Exactly one {set_id} in the HTTPS path; no credentials, IP literals or custom ports.
# Example only: https://your-authorized-provider.example/beatmapsets/{set_id}/download
OSU_ARCHIVE_URL_TEMPLATE=
# Comma-separated extra HTTPS redirect hostnames (template hostname is implicit).
OSU_ARCHIVE_REDIRECT_HOSTS=
RUST_LOG=info,tower_http=info
