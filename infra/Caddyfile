{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip
	request_body {
		max_size 66MB
	}
	handle /healthz {
		respond "ok" 200
	}

	@protocol_hosts host c.{$ILLYA_DOMAIN} ce.{$ILLYA_DOMAIN} c4.{$ILLYA_DOMAIN} api.{$ILLYA_DOMAIN} spectator.{$ILLYA_DOMAIN} bss.{$ILLYA_DOMAIN} a.{$ILLYA_DOMAIN} b.{$ILLYA_DOMAIN}
	handle @protocol_hosts {
		reverse_proxy resonance:8081
	}
	@protocol_paths path /web/* /osu/* /d/* /oauth/* /api/v2/* /signalr/*
	handle @protocol_paths {
		reverse_proxy resonance:8081
	}
	@sanctuary_paths path /api/v1/* /media/*
	handle @sanctuary_paths {
		reverse_proxy sanctuary:8080
	}
	handle {
		reverse_proxy serendipity:3000
	}
}
