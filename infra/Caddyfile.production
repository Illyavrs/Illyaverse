{
	email {$ACME_EMAIL}
	admin off
}

(lazer_user_alias) {
	# Preserve Authorization and query parameters; this is an internal path rewrite.
	@lazer_user_alias {
		method GET HEAD
		path_regexp lazer_user_alias ^/api/v2/(me|users/[^/]+)/$
		# path_regexp cleans repeated slashes; require the original path to match too.
		expression {http.request.uri.path}.matches('^/api/v2/(me|users/[^/]+)/$')
	}
	uri @lazer_user_alias strip_suffix /
}

(website_routes) {
	import lazer_user_alias
	encode zstd gzip
	request_body {
		max_size 71303168
	}
	@protocol_paths path /users /users/ /web/* /osu/* /d/* /oauth/* /api/v2/* /signalr/* /notification-server /notification-server/* /spectator /spectator/* /multiplayer /multiplayer/* /metadata /metadata/*
	handle @protocol_paths {
		reverse_proxy resonance:8081
	}
	@sanctuary_paths path /api/v1/* /media/*
	handle @sanctuary_paths {
		reverse_proxy sanctuary:8080
	}
	handle {
		reverse_proxy serendipity:3000
	}
}

{$ILLYA_DOMAIN} {
	import website_routes
}

osu.{$ILLYA_DOMAIN} {
	import website_routes
}

c.{$ILLYA_DOMAIN}, ce.{$ILLYA_DOMAIN}, c4.{$ILLYA_DOMAIN}, api.{$ILLYA_DOMAIN}, spectator.{$ILLYA_DOMAIN}, bss.{$ILLYA_DOMAIN}, a.{$ILLYA_DOMAIN}, b.{$ILLYA_DOMAIN} {
	import lazer_user_alias
	encode zstd gzip
	reverse_proxy resonance:8081
}

# Container-only liveness endpoint; this port is not published by Compose.
http://:8088 {
	respond /healthz "ok" 200
}
