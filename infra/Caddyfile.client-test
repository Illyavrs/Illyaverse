{
	admin off
	skip_install_trust
}

(lazer_user_alias) {
	# Preserve Authorization and query parameters; this is an internal path rewrite.
	@lazer_user_alias {
		method GET HEAD
		path_regexp lazer_user_alias ^/api/v2/(me|users/[^/]+)/$
		# path_regexp cleans repeated slashes; require the original path to match too.
		expression {http.request.uri.path}.matches('^/api/v2/(me|users/[^/]+)/$')
	}
	uri @lazer_user_alias strip_suffix /
}

# Local diagnostics intentionally omit headers, query strings and bodies.
# Stable authentication may place password hashes in legacy URL queries.
(client_test_diagnostics) {
	log {
		output file /tmp/illyaverse-client-requests.jsonl {
			mode 0600
			roll_size 1MiB
			roll_keep 2
		}
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
				user_id delete
			}
		}
	}
	log_append method {http.request.method}
	log_append host {http.request.host}
	log_append path {http.request.uri.path}
}

(client_test_website) {
	import client_test_diagnostics
	tls internal
	import lazer_user_alias
	encode zstd gzip
	request_body {
		max_size 71303168
	}
	@protocol_paths path /users /users/ /web/* /osu/* /d/* /oauth/* /api/v2/* /signalr/* /notification-server /notification-server/* /spectator /spectator/* /multiplayer /multiplayer/* /metadata /metadata/*
	handle @protocol_paths {
		reverse_proxy resonance:8081
	}
	@sanctuary_paths path /api/v1/* /media/*
	handle @sanctuary_paths {
		reverse_proxy sanctuary:8080
	}
	handle {
		reverse_proxy serendipity:3000
	}
}

illya.test, osu.illya.test {
	import client_test_website
}

c.illya.test, ce.illya.test, c4.illya.test, api.illya.test, spectator.illya.test, bss.illya.test, a.illya.test, b.illya.test {
	import client_test_diagnostics
	tls internal
	import lazer_user_alias
	encode zstd gzip
	request_body {
		max_size 71303168
	}
	reverse_proxy resonance:8081
}

# Container-only liveness endpoint. Compose publishes only loopback 80/443.
http://:8088 {
	respond /healthz "ok" 200
}
